<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.search.SearchFragment"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/backgroundPrimary">

    <!-- Yükleniyor göstergesi -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Scrollable içerik -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="65dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/searchHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/headerColor"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/searchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="Find books, authors, users..."
                    android:background="@android:drawable/editbox_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Browse filtre alanı -->
            <LinearLayout
                android:id="@+id/browseContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="Filter by"
                    android:textColor="@color/textSecondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Seçilen filtreler -->
                <LinearLayout
                    android:id="@+id/selectedChipsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="8dp" />

                <!-- Genre filtresi -->
                <Button
                    android:id="@+id/genreButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Genre"
                    android:backgroundTint="@color/buttonPrimary"
                    android:textColor="@color/button_textPrimary"
                    app:cornerRadius="8dp" />

                <LinearLayout
                    android:id="@+id/genreOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="4dp" />

                <!-- Language filtresi -->
                <Button
                    android:id="@+id/languageButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Language"
                    android:backgroundTint="@color/buttonPrimary"
                    android:textColor="@color/button_textPrimary"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="8dp" />

                <LinearLayout
                    android:id="@+id/languageOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="4dp" />

                <!-- Sıralama butonları -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/mostPopularButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Most Popular"
                        android:backgroundTint="@color/buttonPrimary"
                        android:textColor="@color/button_textPrimary"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/highlyRatedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Highly Rated"
                        android:backgroundTint="@color/buttonPrimary"
                        android:textColor="@color/button_textPrimary"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Gözükmeyen filtre girişi -->
                <EditText
                    android:id="@+id/browseInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Enter a value..."
                    android:visibility="gone" />

                <Button
                    android:id="@+id/browseSubmitButton"
                    android:layout_width="134dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="@color/stars_rated"
                    android:text="Search"
                    android:textColor="@color/button_textSecondary"
                    android:visibility="gone"
                    app:cornerRadius="8dp" />

                <!-- Yapay Zeka arama butonu -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/aiSearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    app:srcCompat="@drawable/ai_search"
                    app:tint="@color/white"
                    app:backgroundTint="@color/buttonSecondary" />

                <!-- Sonuç listesi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
