<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrimary">

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="120dp"
        android:paddingBottom="96dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 📌 "Popular This Week" Title with arrow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/popularTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular This Week"
                    android:textColor="@color/textSecondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/popularArrow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/more"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="See All Popular Books"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <!-- 🔁 Yatay ScrollView (Popular Books) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/boxes_background">

                    <!-- Dummy kitap kutuları -->
                    <View
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/backgroundPrimary" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/backgroundPrimary" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        android:background="@color/backgroundPrimary" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/popularMore"
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/more"
                        android:contentDescription="Go to Popular"
                        android:background="@color/backgroundPrimary"
                        app:tint="@color/textSecondary" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 📌 Grid Başlık -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore More"
                android:textColor="@color/textSecondary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:paddingBottom="8dp" />

            <!-- 🔲 Grid Görünüm -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:background="@color/boxes_background"
                android:columnCount="2"
                android:rowOrderPreserved="false"
                android:useDefaultMargins="true">

                <!-- Dummy kitap kutuları -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:background="@color/backgroundPrimary" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
