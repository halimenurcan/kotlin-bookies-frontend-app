<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp"
    android:background="@color/primary_bordo">

    <!-- title -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BOOKIES"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/background_light"
        android:textAlignment="center"
        android:fontFamily="@font/roboto_condensed_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/headerButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:background="@color/primary_bordo_dark"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/booksButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Books"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:backgroundTint="#2A0303"
            android:textSize="18sp"
            android:layout_marginEnd="20dp"
            app:cornerRadius="24dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ReviewsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reviews"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:backgroundTint="#2A0303"
            android:layout_marginEnd="20dp"
            app:cornerRadius="24dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ListsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lists"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:backgroundTint="#2A0303"
            app:cornerRadius="24dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
