<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/boxes_background"
    android:minHeight="180dp">

    <!-- Başlık ve Takip Et Butonu Yatay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Liste Adı -->
        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="List Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <!-- Takip Et Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/followButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Follow"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/stars_rated"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="4dp"
            />

    </LinearLayout>

    <!-- Kitaplar + See More -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include layout="@layout/add_to_list_card" />
            <!-- Kitap Kutuları -->
            <include layout="@layout/item_book_grid" />
            <include layout="@layout/item_book_grid" />
            <include layout="@layout/item_book_grid" />
            <include layout="@layout/item_book_grid" />
            <include layout="@layout/item_book_grid" />
            <include layout="@layout/item_book_grid" />

            <include layout="@layout/see_more_card" />

        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
